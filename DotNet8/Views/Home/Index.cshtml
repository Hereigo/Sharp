@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@model CalendarViewModel
@{
    ViewData["Title"] = "Calendarium";

    var isSignedIn = SignInManager.IsSignedIn(User);
    var isTodayOnSheet = Model.Today.Month == Model.DisplayedMonth.Month;
    var weekDays = new[] { DayOfWeek.Monday, DayOfWeek.Tuesday, DayOfWeek.Wednesday, DayOfWeek.Thursday, DayOfWeek.Friday, DayOfWeek.Saturday, DayOfWeek.Sunday };
}

<div class="container-fluid">
    <div class="row row-calend">
        <main class="col-md-10">
            <div class="grid calendar">
                @foreach (var weekDay in weekDays)
                {
                    <div class='cell cell-head @(isTodayOnSheet && Model.Today.DayOfWeek == weekDay ? "today" : "")'> @weekDay.ToString()[..3] </div>
                }

                @foreach (var day in Model.Days)
                {
                    var todayCss = Model.Today.Date == day.Date ? "today" : "";
                    var otherMonCss = day.Date.Month == Model.DisplayedMonth.Month ? "" : "nextMon";
                    <div class="cell day @otherMonCss @todayCss">

                        <partial name="EventCalendView" model="day" />

                    </div>
                }
            </div>

        </main>

        @* *** SIDEBAR *** *@

        <aside class="col-md-2 sidebar">
            <div>
                <span class="evnts-cntr">
                    <span>[ @Model.SheetEventsCount ]</span>
                    @if (isSignedIn)
                    {
                        <a asp-action="GetJson" download="calendBkp.json" title="Download all events">[ @Model.TotalEventsCount ]</a>
                    }
                    else
                    {
                        <span>[ @Model.TotalEventsCount ]</span>
                    }
                </span>
            </div>
            <br />
            <ul>
                <li>????? - BKS</li>
                <li>09-30 - CFE</li>
                <li>10-45 - FZO</li>
                <li>11-45 - CFE</li>
                <li>13-45 - LNC</li>
                <li>...</li>
            </ul>
            <br />
            <ul>
                <li>
                    https://www.wordnik.com/words/sophisticated
                </li>
                <li>
                    https://dictionary.cambridge.org/dictionary/english/insist
                </li>
                <li>
                    https://www.merriam-webster.com/dictionary/exaggerated
                </li>
                <li>
                    https://www.definitions.net/definition/merit
                </li>
            </ul>

            @if (Model.IsDevelopment && isSignedIn)
            {
                <br />
                <hr />
                <form asp-action="UploadFile" enctype="multipart/form-data" method="post">
                    <input type="file" class="form-control" name="uploadingFile" />
                    <br />
                    <input class="btn btn-info" type="submit" value="Upload" />
                </form>
            }
        </aside>
    </div>
</div>
