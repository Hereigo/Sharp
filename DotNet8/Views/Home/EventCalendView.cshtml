@model CalendarDay

<div class="number">
    <a asp-action="Create" asp-route-date="@Model.Date.ToString("yyyy-MM-dd")">@Model.Date.Day</a>
</div>

<div>&nbsp;</div>

@foreach (var dayItem in Model.Events)
{
    <div class="day-item-line">

        <a asp-action="Edit" asp-route-id="@dayItem.Id">

            @if (dayItem.Time != TimeSpan.Zero)
            {
                <span class="day-item-time">
                    @dayItem.Time.ToString(@"hh\:mm")
                </span>
                <span> - </span>
            }
            @dayItem.Description

        </a>

    </div>
}
