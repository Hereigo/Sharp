@using System.Globalization
@model CalendarViewModel
@{
    const string displayedMonthBgColor = "rgb(255, 240, 155)";
    var monthLinks = new[] { (Offset: -1, Route: "prev"), (Offset: 0, Route: ""), (Offset: 1, Route: "next") };
}

@foreach (var (offset, route) in monthLinks)
{
    var month = Model.Today.AddMonths(offset);
    var bgColor = month.Month == Model.DisplayedMonth.Month ? displayedMonthBgColor : "";
    <a asp-controller="Home" asp-action="Index" asp-route-pMonth="@route" class="btn btn-sm btn-light" style="background-color:@bgColor"> @month.ToString("MMMM", CultureInfo.InvariantCulture) </a>
    @:&nbsp;
}
